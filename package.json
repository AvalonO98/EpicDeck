{
  "name": "epicdeck",
  "version": "0.9.5-beta.13",
  "packageManager": "pnpm@9.15.9",
  "description": "Epic Games login and download manager for Steam Deck, powered by Legendary",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "package": "python scripts/build_zip.py",
    "typecheck": "tsc --noEmit",
    "test": "python3 scripts/regression.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvalonO98/EpicDeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "epic-games",
    "legendary",
    "deck"
  ],
  "author": "EpicDeck",
  "license": "BSD-3-Clause",
  "remote_binary": [
    {
      "name": "legendary",
      "url": "https://github.com/legendary-gl/legendary/releases/download/0.21.1/legendary_linux_x64",
      "sha256hash": "dbed33bbe96031e65858233e4badf0a1d401bb6cb0cc995d1237cf3a0c826a45"
    }
  ],
  "bugs": {
    "url": "https://github.com/AvalonO98/EpicDeck/issues"
  },
  "homepage": "https://github.com/AvalonO98/EpicDeck#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode": "^1.5.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
